<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login do Administrador - Teste</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, sans-serif;
      background-color: #f4f6f9;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .login-card {
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 360px;
    }

    .login-card h2 {
      margin-top: 0;
      color: #000080;
      text-align: center;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      font-size: 14px;
    }

    .form-group input {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 15px;
    }

    .btn-submit {
      width: 100%;
      padding: 12px;
      background-color: #000080;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .btn-submit:hover {
      background-color: #000055;
    }

    .mensagem-erro {
      color: red;
      font-size: 14px;
      margin-top: 10px;
      text-align: center;
      display: none;
    }

    /* Painel do Admin (Invisível no início) */
    .painel-admin {
      display: none;
      text-align: center;
    }
  </style>
</head>
<body>

  <!-- FORMULÁRIO DE LOGIN -->
  <div class="login-card" id="area-login">
    <h2>Área do Admin</h2>
    <form id="loginForm">
      <div class="form-group">
        <label for="email">E-mail (Gmail):</label>
        <input type="email" id="email" placeholder="seu-email@gmail.com" required>
      </div>

      <div class="form-group">
        <label for="senha">Senha:</label>
        <input type="password" id="senha" placeholder="Digite sua senha" required>
      </div>

      <button type="submit" class="btn-submit">Entrar</button>
      <div id="erro" class="mensagem-erro">E-mail ou senha incorretos!</div>
    </form>
  </div>

  <!-- PAINEL EXIBIDO APÓS O LOGIN -->
  <div class="login-card painel-admin" id="area-admin">
    <h2>Bem-vindo, Victor! 🎉</h2>
    <p>Login efetuado com sucesso (modo de teste).</p>
    <button class="btn-submit" onclick="sair()">Sair</button>
  </div>

  <script>
    // DADOS PARA TESTE (Em um projeto real com banco de dados, isso fica escondido no servidor)
    const EMAIL_TESTE = "admin@gmail.com";
    const SENHA_TESTE = "123456";

    const loginForm = document.getElementById('loginForm');
    const areaLogin = document.getElementById('area-login');
    const areaAdmin = document.getElementById('area-admin');
    const msgErro = document.getElementById('erro');

    loginForm.addEventListener('submit', function(e) {
      e.preventDefault(); // Impede o recarregamento da página

      const emailDigitado = document.getElementById('email').value;
      const senhaDigitada = document.getElementById('senha').value;

      // Validação simples dos dados de teste
      if (emailDigitado === EMAIL_TESTE && senhaDigitada === SENHA_TESTE) {
        msgErro.style.display = 'none';
        areaLogin.style.display = 'none';
        areaAdmin.style.display = 'block';
      } else {
        msgErro.style.display = 'block';
      }
    });

    function sair() {
      areaAdmin.style.display = 'none';
      areaLogin.style.display = 'block';
      document.getElementById('senha').value = '';
    }
  </script>

</body>
</html>
