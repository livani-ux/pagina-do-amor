<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para Valentina ❤️</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        :root {
            --bg-deep: #090B16;
            --bg-card: #121629;
            --accent-purple: #8B5CF6;
            --accent-blue: #3B82F6;
            --text-light: #F3F4F6;
            --text-gold: #FACE15;
            --border-glow: rgba(139, 92, 246, 0.4);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-deep);
            color: var(--text-light);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(59, 130, 246, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(139, 92, 246, 0.15) 0%, transparent 40%);
        }

        .container {
            width: 100%;
            max-width: 520px;
            background: var(--bg-card);
            border: 2px solid var(--border-glow);
            border-radius: 24px;
            padding: 2rem 1.5rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.6);
            text-align: center;
        }

        h1, h2, h3 { font-family: 'Outfit', sans-serif; }

        .welcome-title {
            color: var(--accent-blue);
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }

        .subtitle {
            color: #9CA3AF;
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
        }

        .word-display {
            display: flex;
            gap: 8px;
            justify-content: center;
            margin: 1.5rem 0;
        }

        .letter-box {
            width: 44px;
            height: 52px;
            border: 2px solid var(--accent-purple);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 800;
            background: rgba(139, 92, 246, 0.1);
        }

        .keyboard {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
            margin-top: 1.5rem;
        }

        .key-btn {
            background: #1E2640;
            color: white;
            border: 1px solid #374151;
            border-radius: 6px;
            padding: 10px 0;
            font-weight: 700;
            cursor: pointer;
        }

        .key-btn:hover { background: var(--accent-purple); }

        .hint-box {
            background: rgba(59, 130, 246, 0.1);
            border-left: 4px solid var(--accent-blue);
            padding: 1rem;
            border-radius: 8px;
            text-align: left;
            margin-bottom: 1rem;
            font-size: 0.95rem;
            line-height: 1.4;
        }

        /* Calendário */
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
            margin: 1rem 0;
        }

        .day-name { font-weight: bold; color: var(--accent-blue); font-size: 0.8rem; }
        
        .day-btn {
            background: #1E2640;
            border: 1px solid #374151;
            color: white;
            padding: 8px 0;
            border-radius: 6px;
            cursor: pointer;
        }

        .day-btn.selected {
            background: var(--accent-purple);
            border-color: white;
            font-weight: bold;
        }

        .btn-action {
            width: 100%;
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            margin-top: 1rem;
        }

        .hidden { display: none; }
    </style>
</head>
<body>

<div class="container">
    <!-- Tela Inicial -->
    <div id="screen-game">
        <h1 class="welcome-title">Bem-vinda, Valentina! ✨</h1>
        <p class="subtitle">Adivinhe as palavras em inglês para destravar uma surpresa especial.</p>
        
        <div class="hint-box" id="hint-text">
            Loading...
        </div>

        <div class="word-display" id="word-slots"></div>

        <div class="keyboard" id="keyboard"></div>
    </div>

    <!-- Tela Final -->
    <div id="screen-final" class="hidden">
        <h2 style="color: var(--text-gold); font-size: 1.8rem; margin-bottom: 0.5rem;">Você Venceu! 🎉</h2>
        <p style="margin-bottom: 1.5rem;">Agora é com você! Escolha o que vamos fazer e a data em Dezembro:</p>

        <div style="display: flex; gap: 10px; margin-bottom: 1.5rem;">
            <button class="day-btn" id="opt-cinema" onclick="selectOption('Cinema e Sushi')" style="flex:1; padding: 12px;">🎬 Cinema + Sushi</button>
            <button class="day-btn" id="opt-sushi" onclick="selectOption('Só Sushi')" style="flex:1; padding: 12px;">🍣 Só Sushi</button>
        </div>

        <h3>Escolha um dia em Dezembro 📅</h3>
        <div class="calendar-grid">
            <div class="day-name">D</div><div class="day-name">S</div><div class="day-name">T</div>
            <div class="day-name">Q</div><div class="day-name">Q</div><div class="day-name">S</div><div class="day-name">S</div>
            <!-- Dias vazios do início do mês -->
            <div></div><div></div>
            <!-- Dias 1 a 31 -->
            <script>
                for(let i=1; i<=31; i++){
                    document.write(`<button class="day-btn" onclick="selectDay(${i}, this)">${i}</button>`);
                }
            </script>
        </div>

        <button class="btn-action" onclick="sendWhatsApp()">Confirmar e Enviar no WhatsApp 💬</button>
    </div>
</div>

<script>
    const levels = [
        { word: "MOVIE", hint: "💌 'Estar ao seu lado faz qualquer momento simples parecer cena de cinema. O tempo voa quando estou com você.'" },
        { word: "OR", hint: "💌 'Dizem que a vida é feita de escolhas, mas estar com você sempre vai ser a minha única certeza.'" },
        { word: "SUSHI", hint: "💌 'Amo te ver feliz, dar risada com você e compartilhar momentos saborosos juntos.'" },
        { word: "BOTH", hint: "💌 'Porque quando o assunto é ter você por perto, eu não quero escolher só um... eu quero TUDO!'" }
    ];

    let currentLevel = 0;
    let guessedLetters = [];
    let selectedOption = "";
    let selectedDay = null;

    function initLevel() {
        const level = levels[currentLevel];
        document.getElementById('hint-text').innerText = level.hint;
        guessedLetters = [];
        renderWord();
        renderKeyboard();
    }

    function renderWord() {
        const level = levels[currentLevel];
        const container = document.getElementById('word-slots');
        container.innerHTML = '';
        
        let won = true;
        for (let letter of level.word) {
            const box = document.createElement('div');
            box.className = 'letter-box';
            if (guessedLetters.includes(letter)) {
                box.innerText = letter;
            } else {
                box.innerText = '';
                won = false;
            }
            container.appendChild(box);
        }

        if (won) {
            setTimeout(() => {
                currentLevel++;
                if (currentLevel < levels.length) {
                    initLevel();
                } else {
                    showFinalScreen();
                }
            }, 600);
        }
    }

    function renderKeyboard() {
        const kb = document.getElementById('keyboard');
        kb.innerHTML = '';
        const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split('');
        alphabet.forEach(letra => {
            const btn = document.createElement('button');
            btn.className = 'key-btn';
            btn.innerText = letra;
            btn.onclick = () => {
                if (!guessedLetters.includes(letra)) {
                    guessedLetters.push(letra);
                    renderWord();
                }
            };
            kb.appendChild(btn);
        });
    }

    function showFinalScreen() {
        document.getElementById('screen-game').classList.add('hidden');
        document.getElementById('screen-final').classList.remove('hidden');
        confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
    }

    function selectOption(opt) {
        selectedOption = opt;
        document.getElementById('opt-cinema').classList.remove('selected');
        document.getElementById('opt-sushi').classList.remove('selected');
        if(opt === 'Cinema e Sushi') document.getElementById('opt-cinema').classList.add('selected');
        if(opt === 'Só Sushi') document.getElementById('opt-sushi').classList.add('selected');
    }

    function selectDay(day, btn) {
        selectedDay = day;
        document.querySelectorAll('.calendar-grid .day-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
    }

    function sendWhatsApp() {
        if (!selectedOption || !selectedDay) {
            alert('Por favor, escolha a opção do rolê e um dia no calendário!');
            return;
        }
        const text = `Oii! Ganhei o jogo! ✨%0A%0AOpção escolhida: *${selectedOption}*%0ADia escolhido em Dezembro: *Dia ${selectedDay}*%0A%0ABora? 😉`;
        window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    }

    initLevel();
</script>
</body>
</html>
